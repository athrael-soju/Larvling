{
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-header": "<p align=\"center\">\n  <img src=\"https://github.com/athrael-soju/Larvling/blob/main/larvling.png?raw=true\" alt=\"Larvling logo\" width=\"350\" />\n</p>\n",
      "extra-files": [
        {
          "type": "json",
          "path": "larvling/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
