        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance"
        },
        {
          "type": "refactor",
          "section": "Refactoring"
        },
        {
          "type": "docs",
          "section": "Documentation"
        },
        {
          "type": "style",
          "hidden": true
        },
        {
          "type": "test",
          "hidden": true
        },
        {
          "type": "build",
          "hidden": true
        },
        {
          "type": "ci",
          "hidden": true
        },
        {
          "type": "chore",
          "hidden": true
        }
      ]
    }
  },
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json"
}