<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="revision" content="{{REVISION}}">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Larvling Dashboard</title>
<style>
:root{--bg:#1a1610;--s:#2a2318;--b:#3d3428;--t:#f5f0e6;--m:#a09282;--a:#f5a623;--a2:#f0c850;--u:#2e2215;--ag:#241f15;--sw:260px;--ab1:rgba(245,166,35,.1);--ab2:rgba(245,166,35,.2)}*{margin:0;padding:0;box-sizing:border-box;scrollbar-width:thin;scrollbar-color:var(--b) transparent}html,body{height:100%;overflow:hidden}body{font-family:system-ui,sans-serif;background:var(--bg);color:var(--t);display:flex;flex-direction:column}.topbar{display:flex;align-items:center;gap:.3rem;padding:.35rem 1rem;border-bottom:2px solid var(--a);background:linear-gradient(180deg,#2a2318,var(--bg));flex-shrink:0}.logo{width:80px;height:80px;border-radius:6px}.topbar-link{display:flex;align-items:center;gap:.3rem;text-decoration:none;cursor:pointer}.topbar-tagline{display:flex;flex-direction:column;font-size:.8rem;color:var(--a);font-weight:700;line-height:1.3}.topbar-version{font-size:.6rem;color:var(--m);font-weight:600}.topbar-right{margin-left:auto}.topbar-right input{width:220px;padding:.35rem .75rem;background:var(--s);border:1px solid var(--b);border-radius:5px;color:var(--t);font-size:.8rem;outline:0}.topbar-right input:focus{border-color:var(--a)}.topbar-right input::placeholder{color:var(--m)}.layout{display:flex;flex:1;min-height:0}.sidebar{width:var(--sw);border-right:1px solid var(--b);display:flex;flex-direction:column;flex-shrink:0}.sidebar-controls{padding:.5rem .6rem;border-bottom:1px solid var(--b);display:flex;gap:.35rem;flex-shrink:0}.sidebar-controls select{flex:1;padding:.25rem .3rem;background:var(--s);border:1px solid var(--b);border-radius:4px;color:var(--t);font-size:.7rem;outline:0;cursor:pointer}.sidebar-controls select option{background:var(--s);color:var(--t)}.sidebar-list{overflow-y:auto;flex:1}.sidebar-item{padding:.65rem 1rem;border-bottom:1px solid var(--b);cursor:pointer}.sidebar-item:hover,.sidebar-item.active{background:var(--s)}.sidebar-item.active{border-left:3px solid var(--a)}.si-top{display:flex;justify-content:space-between;align-items:center}.si-date{font-weight:600;font-size:.85rem}.si-time{color:var(--m);font-size:.75rem;margin-left:.4rem}.si-summary{color:var(--m);font-size:.8rem;margin-top:.2rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.si-meta{display:flex;gap:.5rem;margin-top:.2rem;font-size:.7rem;color:var(--m)}.main{flex:1;display:flex;flex-direction:column;min-width:0}.detail-panel{flex:1;display:none;flex-direction:column;min-height:0}.detail-panel.active{display:flex}.detail-header{display:flex;align-items:center;gap:.5rem;padding:.65rem 1.25rem;border-bottom:1px solid var(--b);flex-shrink:0}.detail-date{font-weight:600;font-size:.95rem}.detail-sid{color:var(--m);font-size:.75rem;font-family:monospace;margin-left:auto}.chip{background:var(--ab1);border:1px solid var(--ab2);border-radius:12px;padding:.1rem .5rem;font-size:.7rem;color:var(--a2)}.no-session{flex:1;display:flex;align-items:center;justify-content:center;color:var(--m);font-size:.9rem}.messages{flex:1;display:flex;flex-direction:column;gap:.5rem;overflow-y:auto;padding:1rem 1.25rem}.msg{padding:.5rem .75rem;border-radius:8px;max-width:95%}.msg.search-dim{display:none}.msg.search-hit{border-left:2px solid var(--a)}.msg.search-hit mark{background:rgba(245,166,35,.3);color:inherit;border-radius:2px;padding:0 1px}.msg-user{background:var(--u);align-self:flex-end}.msg-agent{background:var(--ag);align-self:flex-start}.msg-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:.25rem;gap:.75rem}.msg-role{font-weight:600;font-size:.8rem}.msg-user .msg-role{color:var(--a)}.msg-user .msg-header{flex-direction:row-reverse}.msg-agent .msg-role{color:var(--a2)}.msg-time{color:var(--m);font-size:.7rem}.msg-body{font-size:.85rem;line-height:1.5;word-break:break-word;max-height:200px;overflow:hidden;position:relative;cursor:pointer}.msg-body.expanded{max-height:none}.msg-body.truncated::after{content:'';position:absolute;bottom:0;left:0;right:0;height:3rem;pointer-events:none}.msg-agent .msg-body.truncated::after{background:linear-gradient(transparent,var(--ag))}.msg-user .msg-body.truncated::after{background:linear-gradient(transparent,var(--u))}.msg-body.expanded::after{display:none}.msg-expand{display:flex;align-items:center;justify-content:center;gap:.4rem;padding:.3rem 0;margin-top:.2rem;font-size:.7rem;color:var(--a);cursor:pointer;opacity:.8;user-select:none}.msg-expand:hover{opacity:1}.msg-expand .expand-icon{transition:transform .2s}.msg-expand.expanded .expand-icon{transform:rotate(180deg)}.msg-body p{margin:0 0 .4rem}.msg-body p:last-child{margin-bottom:0}.msg-body code{font-family:ui-monospace,monospace;font-size:.8rem;background:rgba(0,0,0,.3);padding:.1rem .3rem;border-radius:3px}.msg-body pre{background:rgba(0,0,0,.35);border:1px solid var(--b);border-radius:6px;padding:.6rem .8rem;overflow-x:auto;margin:.4rem 0}.msg-body pre code{background:0 0;padding:0}.msg-body h1,.msg-body h2,.msg-body h3,.msg-body h4{margin:.5rem 0 .3rem;font-size:.9rem;color:var(--a2)}.msg-body h1{font-size:1rem}.msg-body ul,.msg-body ol{margin:.3rem 0;padding-left:1.4rem}.msg-body li{margin:.15rem 0}.msg-body blockquote{border-left:3px solid var(--b);padding-left:.6rem;margin:.3rem 0;color:var(--m)}.msg-body a{color:var(--a);text-decoration:none}.msg-body a:hover{text-decoration:underline}.msg-body hr{border:none;border-top:1px solid var(--b);margin:.5rem 0}.msg-body table{border-collapse:collapse;margin:.4rem 0;font-size:.8rem}.msg-body th,.msg-body td{border:1px solid var(--b);padding:.25rem .5rem}.msg-body th{background:var(--s)}.msg-tools,.msg-actions{display:flex;gap:.35rem;margin-top:.35rem;flex-wrap:wrap}.tool-badge{font-size:.7rem;padding:.1rem .4rem;background:rgba(245,166,35,.08);border:1px solid rgba(245,166,35,.25);border-radius:4px;color:var(--a2);font-family:monospace}.topic-chip{display:inline-block;font-size:.65rem;padding:.08rem .4rem;background:rgba(120,180,120,.1);border:1px solid rgba(120,180,120,.25);border-radius:10px;color:#8cb88c;margin-right:.2rem}.si-topics{display:flex;gap:.2rem;margin-top:.2rem;flex-wrap:wrap}.detail-header .topic-chip{font-size:.7rem}.sentiment-dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-left:.3rem;vertical-align:middle}.sentiment-dot.positive{background:#5cb85c}.sentiment-dot.neutral-s{background:#f0ad4e}.sentiment-dot.negative{background:#d9534f}.action-badge{font-size:.68rem;padding:.1rem .4rem;background:rgba(100,150,220,.1);border:1px solid rgba(100,150,220,.25);border-radius:4px;color:#7baed8}
</style>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
</head>
<body data-revision="{{REVISION}}">
<div class="topbar">
<a href="https://github.com/athrael-soju/Larvling" target="_blank" class="topbar-link">
<img src="{{LOGO_URL}}" alt="Larvling" class="logo">
<div class="topbar-tagline"><span>Your</span><span>friendly</span><span>memory</span><span>companion</span><span class="topbar-version">v{{VERSION}}</span></div>
</a>
<div class="topbar-right">
<input type="text" id="search" placeholder="Search...">
</div>
</div>
<div class="layout">
<div class="sidebar" id="sidebar">
<div class="sidebar-controls">
<select id="sort-select">
<option value="newest">Newest</option>
<option value="oldest">Oldest</option>
<option value="most-msgs">Most msgs</option>
<option value="longest">Longest</option>
</select>
<select id="filter-select">
<option value="all">All</option>
<option value="today">Today</option>
<option value="week">This week</option>
</select>
</div>
<div class="sidebar-list" id="sidebar-list">
{{SIDEBAR}}
</div>
</div>
<div class="main" id="main">
<div class="no-session" id="no-session">Select a session</div>
{{DETAILS}}
</div>
</div>
<script>
var $=function(s){return document.querySelector(s)},$$=function(s){return document.querySelectorAll(s)},L=list=document.getElementById('sidebar-list'),ss=function(k,v){localStorage.setItem('larvling-'+k,v)},ls=function(k){return localStorage.getItem('larvling-'+k)};marked.setOptions({breaks:true,gfm:true});function fmtS(n){return n>=1e3?(n/1e3).toFixed(1).replace(/\.0$/,'')+'k':n}$$('.msg-body').forEach(function(b){b.dataset.raw=b.textContent;b.innerHTML=marked.parse(b.textContent)});function chkT(c){(c||document).querySelectorAll('.msg-body').forEach(function(b){if(b.parentNode.querySelector('.msg-expand'))return;if(b.scrollHeight>b.clientHeight){b.classList.add('truncated');var s=(b.dataset.raw||'').length,h=document.createElement('div');h.className='msg-expand collapsed';h.innerHTML='<span class="expand-icon">&#x25BC;</span> Show more ('+fmtS(s)+')';h.dataset.size=s;b.parentNode.appendChild(h)}})}function sel(sid){$$('.sidebar-item').forEach(function(e){e.classList.toggle('active',e.dataset.sid===sid)});$$('.detail-panel').forEach(function(e){e.classList.toggle('active',e.dataset.sid===sid)});var ns=$('#no-session');if(ns)ns.style.display=sid?'none':'';var a=$('.detail-panel.active');if(a)chkT(a)}function doSort(v){var items=Array.from(L.querySelectorAll('.sidebar-item'));items.sort(function(a,b){var ae=a.dataset.ended||a.dataset.started,be=b.dataset.ended||b.dataset.started;if(v==='oldest')return ae.localeCompare(be);if(v==='most-msgs')return(parseInt(b.dataset.msgs)||0)-(parseInt(a.dataset.msgs)||0);if(v==='longest')return(parseFloat(b.dataset.duration)||0)-(parseFloat(a.dataset.duration)||0);return be.localeCompare(ae)});items.forEach(function(e){L.appendChild(e)})}function doFilter(v){var now=new Date(),td=now.toISOString().slice(0,10),wk=new Date(now-7*864e5).toISOString().slice(0,10);$$('.sidebar-item').forEach(function(e){var d=(e.dataset.started||'').split(' ')[0]||'',ok=v==='today'?d===td:v==='week'?d>=wk:true;e.style.display=ok?'':'none'})}function hiMsg(q){$$('.msg').forEach(function(m){m.classList.remove('search-hit','search-dim');var b=m.querySelector('.msg-body');if(b&&b.dataset.raw)b.innerHTML=marked.parse(b.dataset.raw)});if(!q)return;var esc=q.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'),re=new RegExp('('+esc+')','gi');$$('.detail-panel').forEach(function(p){p.querySelectorAll('.msg').forEach(function(m){var b=m.querySelector('.msg-body');if(!b||!b.dataset.raw)return;if(b.dataset.raw.toLowerCase().indexOf(q)!==-1){m.classList.add('search-hit');b.innerHTML=marked.parse(b.dataset.raw.replace(re,'<mark>$1</mark>'))}else m.classList.add('search-dim')})})}function run(){doSort($('#sort-select').value);doFilter($('#filter-select').value);var q=$('#search').value.toLowerCase();if(q)$$('.sidebar-item').forEach(function(e){if(e.style.display==='none')return;var sid=e.dataset.sid,p=$('.detail-panel[data-sid="'+sid+'"]');if(e.textContent.toLowerCase().indexOf(q)===-1&&!(p&&p.textContent.toLowerCase().indexOf(q)!==-1))e.style.display='none'});hiMsg(q)}$('#sort-select').onchange=function(){ss('sort',this.value);run()};$('#filter-select').onchange=function(){ss('filter',this.value);run()};$('#search').oninput=function(){ss('search',this.value);run()};L.onclick=function(e){var i=e.target.closest('.sidebar-item');if(i){sel(i.dataset.sid);ss('active',i.dataset.sid)}};document.addEventListener('click',function(e){var t=e.target.closest('.msg-expand')||e.target.closest('.msg-body');if(!t)return;var m=t.closest('.msg');if(!m)return;var mb=m.querySelector('.msg-body'),mh=m.querySelector('.msg-expand');if(!mb)return;if(mb.classList.contains('expanded')){mb.classList.remove('expanded');mb.classList.add('truncated');if(mh){mh.classList.remove('expanded');mh.classList.add('collapsed');mh.innerHTML='<span class="expand-icon">&#x25BC;</span> Show more ('+fmtS(parseInt(mh.dataset.size))+')'}}else if(mb.classList.contains('truncated')||mh){mb.classList.add('expanded');mb.classList.remove('truncated');if(mh){mh.classList.remove('collapsed');mh.classList.add('expanded');mh.innerHTML='<span class="expand-icon">&#x25BC;</span> Show less'}}});(function(){var s=ls('sort'),f=ls('filter'),q=ls('search'),sid=ls('active');if(s)$('#sort-select').value=s;if(f)$('#filter-select').value=f;if(q)$('#search').value=q;run();if(sid&&$('.sidebar-item[data-sid="'+sid+'"]'))sel(sid);else{var first=L.querySelector('.sidebar-item:not([style*="display: none"])');if(first)sel(first.dataset.sid)}})();(function(){var cr=document.body.dataset.revision;setInterval(function(){var x=new XMLHttpRequest();x.open('GET','larvling-revision',true);x.onload=function(){if(x.status===200||x.status===0){var r=x.responseText.trim();if(r&&r!==cr)location.reload()}};x.send()},3e3)})();
</script>
</body>
</html>
