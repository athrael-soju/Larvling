{
  "description": "Larvling lifecycle hooks for conversation tracking and dashboard generation",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/preflight.py\" && python \"${CLAUDE_PLUGIN_ROOT}/scripts/dashboard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.py\" && python \"${CLAUDE_PLUGIN_ROOT}/scripts/dashboard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.py\" && python \"${CLAUDE_PLUGIN_ROOT}/scripts/extract.py\" && python \"${CLAUDE_PLUGIN_ROOT}/scripts/dashboard.py\"",
            "timeout": 90
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.py\" && python \"${CLAUDE_PLUGIN_ROOT}/scripts/auto_summarize.py\" && python \"${CLAUDE_PLUGIN_ROOT}/scripts/dashboard.py\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
