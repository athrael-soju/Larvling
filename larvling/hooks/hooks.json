{
  "description": "Larvling lifecycle hooks for conversation tracking, dashboard, and agent-powered memory",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/preflight.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/dashboard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_prompt.py\" && python \"${CLAUDE_PLUGIN_ROOT}/scripts/dashboard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_stop.py\" && python \"${CLAUDE_PLUGIN_ROOT}/scripts/dashboard.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_agents.py\"",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_stop.py\" end && python \"${CLAUDE_PLUGIN_ROOT}/scripts/dashboard.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
