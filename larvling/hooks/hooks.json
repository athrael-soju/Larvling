{
  "description": "Larvling lifecycle hooks for conversation tracking and dashboard generation",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/preflight.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/dashboard.py\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/dashboard.py\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "_TMP=$(mktemp) && cat >\"$_TMP\" && python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.py\" <\"$_TMP\" && python \"${CLAUDE_PLUGIN_ROOT}/scripts/extract.py\" <\"$_TMP\"; rm -f \"$_TMP\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/dashboard.py\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/precompact.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "_TMP=$(mktemp) && cat >\"$_TMP\" && python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.py\" <\"$_TMP\" && python \"${CLAUDE_PLUGIN_ROOT}/scripts/auto_summarize.py\" <\"$_TMP\"; rm -f \"$_TMP\"",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/dashboard.py\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
