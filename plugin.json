{
  "name": "larvling",
  "description": "Agentic memory — automatic conversation tracking, session context, and a searchable dashboard for Claude Code",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/preflight.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/dashboard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.py\" && python \"${CLAUDE_PLUGIN_ROOT}/scripts/dashboard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.py\" && python \"${CLAUDE_PLUGIN_ROOT}/scripts/dashboard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.py\" && python \"${CLAUDE_PLUGIN_ROOT}/scripts/dashboard.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
